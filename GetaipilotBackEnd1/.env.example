# Existing authentication and Telegram API configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
TELEGRAM_API_ID=replace-with-api-id
TELEGRAM_API_HASH=replace-with-api-hash

# Disabled until both session migrations and staging tests pass.
TELEGRAM_DURABLE_LOGIN=false
# Backend-only secret. Never set this as a VITE_* frontend variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-service-role-key
TELEGRAM_SESSION_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}
TELEGRAM_SESSION_ACTIVE_KEY_VERSION=v1
